# Copy to .env.local and adjust.
# Frontend env values are embedded into the built JS bundle.
# Never put server secrets, DB credentials, JWT secrets, or service account keys here.
VITE_API_BASE_URL=/api/v1

# For Vercel + local backend via ngrok:
# VITE_API_BASE_URL=https://your-ngrok-domain.ngrok-free.app/api/v1
# VITE_WS_BASE_URL=wss://your-ngrok-domain.ngrok-free.app/ws
VITE_WS_BASE_URL=
